// Window chrome: navigation rail, header and footer.

import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { Icons } from "../icons.slint";
import { NavItem } from "nav.slint";
import { StatusPill } from "controls.slint";

export component Rail inherits Rectangle {
    width: 92px;
    background: Theme.rail;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Rectangle {
            height: 54px;
            background: transparent;

            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 10px;
                    background: Theme.accent;

                    Text {
                        text: "MSI";
                        color: Theme.on-accent;
                        font-size: 10px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        NavItem {
            icon: Icons.dashboard;
            label: "Overview";
            active: AppState.page == 0;
            clicked => { AppState.page = 0; }
        }
        NavItem {
            icon: Icons.cooling;
            label: "Cooling";
            active: AppState.page == 1;
            clicked => { AppState.page = 1; }
        }
        NavItem {
            icon: Icons.battery;
            label: "Battery";
            active: AppState.page == 2;
            clicked => { AppState.page = 2; }
        }
        NavItem {
            icon: Icons.sliders;
            label: "System";
            active: AppState.page == 3;
            clicked => { AppState.page = 3; }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Text {
            text: AppState.theme-name;
            color: Theme.faint;
            font-size: Theme.fs-caption;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component Header inherits HorizontalLayout {
    spacing: 12px;
    cross-axis-alignment: center;

    VerticalLayout {
        spacing: 3px;

        Text {
            text: AppState.model-name;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 700;
        }
        Text {
            text: AppState.subtitle;
            color: Theme.muted;
            font-size: Theme.fs-small;
        }
    }

    Rectangle { horizontal-stretch: 1; background: transparent; }

    StatusPill {
        label: AppState.ac-online ? "On AC power" : "On battery";
        tint: AppState.ac-online ? Theme.ok : Theme.warn;
    }
}

export component Footer inherits HorizontalLayout {
    spacing: 8px;

    Text {
        text: AppState.status == "" ? "Ready" : AppState.status;
        color: AppState.status == "" ? Theme.faint : Theme.text;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    Rectangle { horizontal-stretch: 1; background: transparent; }

    Text {
        text: AppState.backend-label + "  ·  " + AppState.theme-name;
        color: Theme.faint;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
    }
}

// Interactive controls.

import { Theme } from "../theme.slint";

export component SectionLabel inherits Text {
    color: Theme.faint;
    font-size: Theme.fs-caption;
    font-weight: 700;
    letter-spacing: 1.2px;
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.ok;

    width: 132px;
    height: 30px;
    border-radius: 15px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 7px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 4px;
            background: root.tint;
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.fs-caption;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component ModeTile inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked();

    horizontal-stretch: 1;
    height: 68px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent-soft : (touch.has-hover ? Theme.surface-alt : Theme.surface);
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    animate background { duration: 120ms; }

    VerticalLayout {
        padding: 13px;
        spacing: 2px;

        Text {
            text: root.title;
            color: selected ? Theme.text-bright : Theme.text;
            font-size: Theme.fs-body;
            font-weight: 600;
        }
        Text {
            text: root.detail;
            color: selected ? Theme.accent : Theme.muted;
            font-size: Theme.fs-caption;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> on: false;
    callback toggled();

    horizontal-stretch: 1;
    height: 58px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.surface-alt : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 600;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: Theme.fs-caption;
            }
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Rectangle {
            width: 42px;
            height: 24px;
            border-radius: 12px;
            background: root.on ? Theme.accent : Theme.surface-alt;
            border-width: 1px;
            border-color: root.on ? Theme.accent : Theme.border-strong;
            animate background { duration: 140ms; }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                y: 3px;
                x: root.on ? 21px : 3px;
                background: root.on ? Theme.on-accent : Theme.muted;
                animate x { duration: 140ms; }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
        mouse-cursor: pointer;
    }
}

export component LevelBar inherits Rectangle {
    in property <int> value: 0;
    in property <int> maximum: 100;
    in property <color> tint: Theme.accent;

    height: 8px;
    border-radius: 4px;
    background: Theme.surface-alt;

    Rectangle {
        height: 8px;
        border-radius: 4px;
        width: root.maximum > 0 ? parent.width * root.value / root.maximum : 0px;
        background: root.tint;
        animate width { duration: 300ms; }
    }
}

// Draggable 20-100 % track. Emits `released` once, on pointer up, so a drag
// does not turn into a burst of EC writes.
export component FanSlider inherits Rectangle {
    in-out property <int> value: 50;
    in property <int> minimum: 20;
    in property <int> maximum: 100;
    in property <bool> interactive: true;
    callback released(int);

    private property <float> fraction: root.maximum > root.minimum
        ? (root.value - root.minimum) / (root.maximum - root.minimum)
        : 0.0;

    // Pointer x -> value, with the thumb kept inside the track ends.
    pure function value-at(x: length) -> int {
        return Math.round(
            root.minimum
            + (root.maximum - root.minimum) * Math.max(0.0, Math.min(1.0, x / root.width))
        );
    }

    height: 34px;
    background: transparent;
    opacity: root.interactive ? 1.0 : 0.45;

    // Track.
    Rectangle {
        y: (root.height - 8px) / 2;
        height: 8px;
        width: root.width - 16px;
        x: 8px;
        border-radius: 4px;
        background: Theme.surface-alt;
    }

    // Filled part.
    Rectangle {
        y: (root.height - 8px) / 2;
        height: 8px;
        x: 8px;
        width: (root.width - 16px) * root.fraction;
        border-radius: 4px;
        background: root.value < 35 ? Theme.warn : Theme.accent;
        animate width { duration: 90ms; }
    }

    // Thumb.
    Rectangle {
        y: (root.height - 16px) / 2;
        x: 8px + (root.width - 16px) * root.fraction - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.text-bright;
        border-width: 2px;
        border-color: Theme.accent;
        animate x { duration: 90ms; }
    }

    ta := TouchArea {
        enabled: root.interactive;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                root.value = root.value-at(ta.mouse-x);
            }
            if (event.kind == PointerEventKind.up) {
                root.value = root.value-at(ta.mouse-x);
                root.released(root.value);
            }
        }
        mouse-cursor: pointer;
    }
}

// Compact text button, for "restore" style secondary actions.
export component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    min-width: btn-text.preferred-width + 26px;
    preferred-width: btn-text.preferred-width + 26px;
    border-radius: 8px;
    background: enabled && touch.has-hover ? Theme.surface-alt : transparent;
    border-width: 1px;
    border-color: enabled ? Theme.border-strong : Theme.border;
    opacity: enabled ? 1.0 : 0.5;

    btn-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.enabled ? Theme.text : Theme.faint;
        font-size: Theme.fs-caption;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// MSI Center replacement - UI.
// Visual language: near-black chrome, single red accent, rounded cards,
// icon rail on the left, as in MSI Center 2.x on Windows.

global Theme {
    out property <color> bg: #0a0c10;
    out property <color> rail: #0d1015;
    out property <color> surface: #141922;
    out property <color> surface-2: #1b2230;
    out property <color> border: #232c3a;
    out property <color> text: #e9eef7;
    out property <color> muted: #8592a6;
    out property <color> accent: #e01b2e;
    out property <color> accent-soft: #3a1220;
    out property <color> ok: #2fbf71;
    out property <color> warn: #f0a02a;
}

// ---------------------------------------------------------------------------
// Building blocks
// ---------------------------------------------------------------------------

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 68px;
    border-radius: 14px;
    background: active ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: active ? Theme.border : transparent;

    VerticalLayout {
        spacing: 4px;
        alignment: center;

        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            background: active ? Theme.accent : Theme.surface;
            Text {
                text: root.glyph;
                color: active ? #ffffff : Theme.muted;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: active ? Theme.text : Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> unit;
    in property <string> note;
    in property <color> tint: Theme.accent;

    border-radius: 16px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 132px;

    VerticalLayout {
        padding: 18px;
        spacing: 6px;

        Text {
            text: root.title;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.8px;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 34px;
                font-weight: 700;
            }
            Text {
                text: root.unit;
                color: root.tint;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: bottom;
            }
        }
        Text {
            text: root.note;
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

component TrendCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> plot;
    in property <color> tint: Theme.accent;

    border-radius: 16px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 170px;

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.value;
                color: root.tint;
                font-size: 16px;
                font-weight: 700;
            }
        }

        Path {
            width: 100%;
            height: 96px;
            viewbox-width: 1000;
            viewbox-height: 100;
            commands: root.plot;
            fill: transparent;
            stroke: root.tint;
            stroke-width: 2px;
        }
    }
}

component LevelBar inherits Rectangle {
    in property <int> value: 0;
    in property <int> maximum: 100;
    in property <color> tint: Theme.accent;

    height: 10px;
    border-radius: 5px;
    background: Theme.surface-2;

    Rectangle {
        height: 10px;
        border-radius: 5px;
        width: root.maximum > 0 ? parent.width * root.value / root.maximum : 0px;
        background: root.tint;
        animate width { duration: 300ms; }
    }
}

component ModeButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected: false;
    callback clicked();

    height: 76px;
    border-radius: 14px;
    background: selected ? Theme.accent-soft : Theme.surface-2;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;

    VerticalLayout {
        padding: 14px;
        spacing: 3px;
        Text {
            text: root.title;
            color: selected ? #ffffff : Theme.text;
            font-size: 14px;
            font-weight: 600;
        }
        Text {
            text: root.subtitle;
            color: selected ? #ff9aa5 : Theme.muted;
            font-size: 11px;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on: false;
    callback toggled();

    height: 62px;
    border-radius: 12px;
    background: Theme.surface-2;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; }
            Text { text: root.subtitle; color: Theme.muted; font-size: 11px; }
        }

        Rectangle {
            width: 46px;
            height: 26px;
            border-radius: 13px;
            background: root.on ? Theme.accent : Theme.border;
            animate background { duration: 150ms; }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: #ffffff;
                y: 3px;
                x: root.on ? 23px : 3px;
                animate x { duration: 150ms; }
            }
        }
    }

    TouchArea {
        clicked => { root.toggled(); }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "MSI Center";
    width: 1160px;
    height: 760px;
    background: Theme.bg;
    default-font-family: "Adwaita Sans";

    // data pushed from Rust (pre-formatted; Slint does no number formatting)
    in property <string> model-name: "MSI Modern 15 B7M";
    in property <string> subtitle: "";
    in property <string> backend-label: "";
    in property <string> cpu-temp: "--";
    in property <string> fan-rpm: "--";
    in property <string> fan-level: "--";
    in property <string> battery: "--";
    in property <int> battery-percent: 0;
    in property <string> battery-limit: "--";
    in property <bool> ac-online: false;
    in property <bool> cooler-boost: false;
    in property <string> shift-mode: "comfort";
    in property <string> fan-mode: "auto";
    in property <int> kbd-level: 0;
    in property <int> kbd-max: 3;
    in property <string> kbd-label: "";
    in property <bool> webcam-blocked: false;
    in property <bool> win-key-left: false;
    in property <string> fn-win-label: "";
    in property <string> status: "";
    in property <string> temp-plot: "";

    in-out property <int> page: 0;

    callback set-shift(string);
    callback set-fan(string);
    callback toggle-cooler();
    callback set-battery-limit(int);
    callback cycle-keyboard();
    callback toggle-webcam();
    callback toggle-fnswap();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;

    HorizontalLayout {
        // ---- icon rail ----------------------------------------------------
        Rectangle {
            width: 96px;
            background: Theme.rail;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Rectangle {
                    height: 56px;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Rectangle {
                            width: 34px; height: 34px; border-radius: 10px;
                            background: Theme.accent;
                            Text {
                                text: "MSI"; color: #ffffff; font-size: 10px;
                                font-weight: 800; horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                NavItem {
                    glyph: "D"; label: "Dashboard"; active: page == 0;
                    clicked => { page = 0; }
                }
                NavItem {
                    glyph: "F"; label: "Cooling"; active: page == 1;
                    clicked => { page = 1; }
                }
                NavItem {
                    glyph: "B"; label: "Battery"; active: page == 2;
                    clicked => { page = 2; }
                }
                NavItem {
                    glyph: "S"; label: "System"; active: page == 3;
                    clicked => { page = 3; }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        // ---- content ------------------------------------------------------
        VerticalLayout {
            padding: 26px;
            spacing: 18px;

            // header
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: model-name;
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: subtitle;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Rectangle {
                    height: 34px;
                    width: 132px;
                    border-radius: 17px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 7px;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            background: ac-online ? Theme.ok : Theme.warn;
                        }
                        Text {
                            text: ac-online ? "On AC power" : "On battery";
                            color: Theme.text;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // ---- Dashboard ------------------------------------------------
            if page == 0 : VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 16px;
                    Card {
                        title: "CPU TEMPERATURE";
                        value: cpu-temp;
                        unit: "";
                        note: "EC sensor 0x71";
                        tint: cpu-temp == "--" ? Theme.muted : Theme.warn;
                    }
                    Card {
                        title: "FAN SPEED";
                        value: fan-rpm;
                        unit: "RPM";
                        note: "tachometer 0xCC/0xCD";
                        tint: Theme.accent;
                    }
                    Card {
                        title: "FAN LEVEL";
                        value: fan-level;
                        unit: "/100";
                        note: "EC thermal level";
                        tint: Theme.muted;
                    }
                    Card {
                        title: "BATTERY";
                        value: battery;
                        unit: "%";
                        note: battery-limit == "--" ? "no charge limit" : "charge limit " + battery-limit + "%";
                        tint: Theme.ok;
                    }
                }

                Text {
                    text: "POWER MODE";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    height: 76px;
                    ModeButton {
                        title: "Super Battery"; subtitle: "eco";
                        selected: shift-mode == "eco";
                        clicked => { root.set-shift("eco"); }
                    }
                    ModeButton {
                        title: "Balanced"; subtitle: "comfort";
                        selected: shift-mode == "comfort";
                        clicked => { root.set-shift("comfort"); }
                    }
                    ModeButton {
                        title: "High Performance"; subtitle: "sport";
                        selected: shift-mode == "sport";
                        clicked => { root.set-shift("sport"); }
                    }
                }

                ToggleRow {
                    title: "Cooler Boost";
                    subtitle: "Runs both fans at maximum";
                    on: cooler-boost;
                    toggled => { root.toggle-cooler(); }
                }

                TrendCard {
                    title: "CPU TEMPERATURE · LAST 2 MINUTES";
                    value: cpu-temp;
                    plot: temp-plot;
                    tint: Theme.accent;
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text {
                    text: status;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // ---- Cooling --------------------------------------------------
            if page == 1 : VerticalLayout {
                spacing: 16px;

                Text {
                    text: "FAN MODE";
                    color: Theme.muted; font-size: 11px; font-weight: 700;
                    letter-spacing: 1px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    height: 76px;
                    ModeButton {
                        title: "Auto"; subtitle: "EC decides";
                        selected: fan-mode == "auto";
                        clicked => { root.set-fan("auto"); }
                    }
                    ModeButton {
                        title: "Silent"; subtitle: "lowest noise";
                        selected: fan-mode == "silent";
                        clicked => { root.set-fan("silent"); }
                    }
                    ModeButton {
                        title: "Advanced"; subtitle: "custom curve";
                        selected: fan-mode == "advanced";
                        clicked => { root.set-fan("advanced"); }
                    }
                }

                ToggleRow {
                    title: "Cooler Boost";
                    subtitle: "Maximum fan speed, ignores the curve";
                    on: cooler-boost;
                    toggled => { root.toggle-cooler(); }
                }

                HorizontalLayout {
                    spacing: 16px;
                    Card { title: "FAN SPEED"; value: fan-rpm; unit: "RPM"; note: "measured"; tint: Theme.accent; }
                    Card { title: "CPU"; value: cpu-temp; unit: ""; note: "package temperature"; tint: Theme.warn; }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text { text: status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            }

            // ---- Battery --------------------------------------------------
            if page == 2 : VerticalLayout {
                spacing: 16px;

                Rectangle {
                    border-radius: 16px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            text: "CHARGE LEVEL";
                            color: Theme.muted;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: battery;
                                color: Theme.text;
                                font-size: 40px;
                                font-weight: 700;
                            }
                            Text {
                                text: "%";
                                color: Theme.ok;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: bottom;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: ac-online ? "charging / on AC" : "on battery";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: bottom;
                            }
                        }
                        LevelBar { value: root.battery-percent; tint: Theme.ok; }
                    }
                }

                Text {
                    text: "CHARGE LIMIT";
                    color: Theme.muted; font-size: 11px; font-weight: 700;
                    letter-spacing: 1px;
                }

                Text {
                    text: "Capping the charge level extends battery life when the laptop stays plugged in.";
                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    height: 76px;
                    ModeButton {
                        title: "60%"; subtitle: "best longevity";
                        selected: battery-limit == "60";
                        clicked => { root.set-battery-limit(60); }
                    }
                    ModeButton {
                        title: "80%"; subtitle: "balanced";
                        selected: battery-limit == "80";
                        clicked => { root.set-battery-limit(80); }
                    }
                    ModeButton {
                        title: "100%"; subtitle: "full capacity";
                        selected: battery-limit == "100";
                        clicked => { root.set-battery-limit(100); }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text { text: status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            }

            // ---- System ---------------------------------------------------
            if page == 3 : VerticalLayout {
                spacing: 16px;

                Card {
                    title: "MODEL";
                    value: model-name;
                    unit: "";
                    note: subtitle;
                    tint: Theme.accent;
                }

                ToggleRow {
                    title: "Keyboard backlight";
                    subtitle: kbd-label;
                    on: kbd-level > 0;
                    toggled => { root.cycle-keyboard(); }
                }

                ToggleRow {
                    title: "Swap Fn / Win keys";
                    subtitle: fn-win-label;
                    on: win-key-left;
                    toggled => { root.toggle-fnswap(); }
                }

                ToggleRow {
                    title: "Block webcam";
                    subtitle: "EC-level kill switch";
                    on: webcam-blocked;
                    toggled => { root.toggle-webcam(); }
                }

                Card {
                    title: "BACKEND";
                    value: backend-label;
                    unit: "";
                    note: "msi-ec platform driver";
                    tint: Theme.muted;
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text { text: status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
    }
    }
}

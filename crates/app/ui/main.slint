// MSI Center replacement - application window.
//
// Colours come from the active Omarchy theme at startup (crates/app/src/theme.rs).
// Layout: fixed icon rail, a scrolling-free page area, and a status footer.

import { Theme } from "theme.slint";
import { AppState } from "state.slint";

// Re-export the globals so the Rust bindings can reach them.
export { Theme } from "theme.slint";
export { AppState } from "state.slint";
import { Rail, Header, Footer } from "components/chrome.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { CoolingPage } from "pages/cooling.slint";
import { BatteryPage } from "pages/battery.slint";
import { SystemPage } from "pages/system.slint";

export component AppWindow inherits Window {
    title: "MSI Center";
    width: 1180px;
    height: 780px;
    background: Theme.bg;
    default-font-family: Theme.font-family;

    HorizontalLayout {
        Rail { }

        VerticalLayout {
            padding: Theme.page-padding;
            spacing: 16px;

            Header { }

            if AppState.page == 0 : DashboardPage { }
            if AppState.page == 1 : CoolingPage { }
            if AppState.page == 2 : BatteryPage { }
            if AppState.page == 3 : SystemPage { }

            Footer { }
        }
    }
}

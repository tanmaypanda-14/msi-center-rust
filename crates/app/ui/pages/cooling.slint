import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { StatCard, TrendCard } from "../components/cards.slint";
import { SectionLabel, ModeTile, SwitchRow, FanSlider, TextButton } from "../components/controls.slint";

export component CoolingPage inherits VerticalLayout {
    spacing: 15px;

    SectionLabel { text: "FAN MODE"; }

    HorizontalLayout {
        spacing: 12px;
        height: 68px;

        ModeTile {
            title: "Auto";
            detail: "the EC decides";
            selected: AppState.fan-mode == "auto";
            clicked => { AppState.set-fan("auto"); }
        }
        ModeTile {
            title: "Silent";
            detail: "lowest noise";
            selected: AppState.fan-mode == "silent";
            clicked => { AppState.set-fan("silent"); }
        }
        ModeTile {
            title: "Advanced";
            detail: "custom curve";
            selected: AppState.fan-mode == "advanced";
            clicked => { AppState.set-fan("advanced"); }
        }
    }

    SwitchRow {
        title: "Cooler Boost";
        detail: "Maximum fan speed, ignores the curve";
        on: AppState.cooler-boost;
        toggled => { AppState.toggle-cooler(); }
    }

    HorizontalLayout {
        spacing: 14px;

        StatCard {
            title: "FAN SPEED";
            value: AppState.fan-rpm;
            unit: "RPM";
            note: "measured over the last second";
            tint: Theme.accent;
        }
        StatCard {
            title: "CPU TEMPERATURE";
            value: AppState.cpu-temp;
            unit: "";
            note: "package temperature";
            tint: Theme.warn;
        }
    }

    // Manual override: a flat fan curve written to the EC by the setuid
    // helper. The slider only commits on release, so dragging is one write.
    Rectangle {
        horizontal-stretch: 1;
        height: 120px;
        border-radius: Theme.radius-card;
        background: Theme.surface;
        border-width: 1px;
        border-color: AppState.manual-fan-active ? Theme.accent : Theme.border;

        VerticalLayout {
            padding: 14px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "MANUAL FAN SPEED";
                    color: Theme.faint;
                    font-size: Theme.fs-caption;
                    font-weight: 600;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Text {
                    text: AppState.manual-fan-active ? AppState.manual-fan + "% fixed" : "EC curve active";
                    color: AppState.manual-fan-active ? Theme.accent : Theme.muted;
                    font-size: Theme.fs-caption;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            FanSlider {
                value: AppState.manual-fan;
                minimum: 20;
                maximum: 100;
                interactive: AppState.manual-fan-available;
                released(percent) => { AppState.set-manual-fan(percent); }
            }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: AppState.manual-fan-available
                        ? "Overrides the EC curve with one fixed speed."
                        : "Needs msi-ec loaded with debug=1 plus the fan helper.";
                    color: Theme.muted;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                TextButton {
                    label: "Restore EC curve";
                    enabled: AppState.manual-fan-available && AppState.manual-fan-active;
                    clicked => { AppState.restore-fan-curve(); }
                }
            }
        }
    }

    TrendCard {
        title: "THERMAL HISTORY  ·  LAST 2 MINUTES";
        value: AppState.cpu-temp;
        plot: AppState.temp-plot;
        tint: Theme.accent;
    }
}

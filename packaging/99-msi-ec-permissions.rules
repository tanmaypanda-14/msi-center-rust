# Give the `msi-ec` group write access to exactly the attributes msi-center
# uses. Everything else stays root-only. The raw EC image is handled by
# msi-ec-tmpfiles.conf (read-only), not by udev: debugfs produces no uevents.
#
# Each rule resets ownership to root and strips group-write from the whole
# tree first, then grants both on an explicit list. That makes an upgrade
# from an older, broader rule converge without a reboot.

# Shift mode, fan mode, cooler boost, webcam block, Fn/Win swap.
# The keyboard LED lives under the msi-ec platform device; it is re-granted
# here after the -R strip so a platform event arriving after the LED event
# cannot leave the backlight read-only.
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="msi-ec", \
  RUN+="/bin/chgrp -R root /sys/devices/platform/msi-ec", \
  RUN+="/bin/chmod -R g-w /sys/devices/platform/msi-ec", \
  RUN+="/bin/chgrp msi-ec /sys/devices/platform/msi-ec/shift_mode /sys/devices/platform/msi-ec/fan_mode /sys/devices/platform/msi-ec/cooler_boost /sys/devices/platform/msi-ec/webcam_block /sys/devices/platform/msi-ec/win_key", \
  RUN+="/bin/chmod g+w /sys/devices/platform/msi-ec/shift_mode /sys/devices/platform/msi-ec/fan_mode /sys/devices/platform/msi-ec/cooler_boost /sys/devices/platform/msi-ec/webcam_block /sys/devices/platform/msi-ec/win_key", \
  RUN+="/bin/chgrp msi-ec /sys/class/leds/msiacpi::kbd_backlight/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/msiacpi::kbd_backlight/brightness"

# Battery charge threshold. %S%p is the real sysfs directory: BAT1 in
# /sys/class is a symlink, and chgrp -R does not dereference a command-line
# symlink, so the symlinked path silently changes nothing.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT1", \
  RUN+="/bin/chgrp -R root /sys%p", \
  RUN+="/bin/chmod -R g-w /sys%p", \
  RUN+="/bin/chgrp msi-ec /sys%p/charge_control_end_threshold", \
  RUN+="/bin/chmod g+w /sys%p/charge_control_end_threshold"

# Keyboard backlight: also granted on its own event, so it converges even if
# the LED device is registered after the platform device's event.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="msiacpi::kbd_backlight", \
  RUN+="/bin/chgrp msi-ec /sys/class/leds/msiacpi::kbd_backlight/brightness", \
  RUN+="/bin/chmod g+w /sys/class/leds/msiacpi::kbd_backlight/brightness"

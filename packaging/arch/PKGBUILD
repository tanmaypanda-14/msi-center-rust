# Maintainer: Tanmay Panda <tanmay404103@outlook.com>

pkgname=msi-center
pkgver=0.3.0
pkgrel=1
pkgdesc="Lightweight native replacement for MSI Center, driven by msi-ec"
arch=('x86_64')
url="https://github.com/tanmaypanda-14/msi-center-rust"
license=('MIT')
depends=('fontconfig' 'freetype2')
makedepends=('cargo' 'rust' 'git')
optdepends=('msi-ec-dkms: kernel driver required for real hardware')
# Pinned source snapshot: 0.3.0 (themed UI, modular shell, self-update).
_commit=6c793b461aac460e34d8966a761bca011ca34112
source=("git+$url.git#commit=$_commit")
sha256sums=('SKIP')
install=msi-center.install

build() {
  cd "$srcdir/msi-center-rust"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --locked
}

package() {
  cd "$srcdir/msi-center-rust"

  install -Dm755 target/release/msi-center "$pkgdir/usr/bin/msi-center"
  # setuid root: the only way to reach msi-ec's raw-write node. It accepts a
  # fan speed only, so it cannot be used to touch other EC registers.
  install -Dm755 target/release/msi-fan-helper "$pkgdir/usr/bin/msi-fan-helper"
  chmod 4755 "$pkgdir/usr/bin/msi-fan-helper"
  install -Dm644 packaging/msi-center.desktop "$pkgdir/usr/share/applications/msi-center.desktop"
  install -Dm644 packaging/msi-center.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/msi-center.svg"

  # system integration: group, udev, read-only raw EC for the tachometer,
  # module loading and the boot-safe debugfs permission unit
  install -Dm644 packaging/msi-ec-sysusers.conf "$pkgdir/usr/lib/sysusers.d/msi-ec.conf"
  install -Dm644 packaging/msi-ec-tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/msi-ec.conf"
  install -Dm644 packaging/99-msi-ec-permissions.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-msi-ec-permissions.rules"
  install -Dm644 packaging/msi-ec-modprobe.conf "$pkgdir/usr/lib/modprobe.d/msi-ec.conf"
  install -Dm644 packaging/msi-ec-modules-load.conf \
    "$pkgdir/usr/lib/modules-load.d/msi-ec.conf"
  install -Dm644 packaging/msi-ec-perms.service \
    "$pkgdir/usr/lib/systemd/system/msi-ec-perms.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
